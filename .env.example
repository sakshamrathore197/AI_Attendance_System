# =====================================================================
# Database Configuration
# =====================================================================
# Option 1: Full PostgreSQL URL (recommended for production/cloud)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Option 2: Discrete PostgreSQL Parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=attendance_db

# Option 3: Fallback SQLite (default if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///attendance.db

# =====================================================================
# Docker Compose Variables
# =====================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance_db
POSTGRES_PORT=5432
